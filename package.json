{
  "name": "fenix-project-manager",
  "version": "1.0.0",
  "description": "AI-powered document generation platform for operations leaders",
  "main": "dist/api/server.js",
  "scripts": {
    "dev": "ts-node src/api/server.ts",
    "build": "tsc",
    "build:prod": "tsc --skipLibCheck",
    "build:render": "tsc --skipLibCheck || echo 'Build completed with warnings'",
    "build-harmony-app": "powershell -ExecutionPolicy Bypass -File build-harmony-app.ps1",
    "start": "node render-server.js",
    "start:prod": "NODE_ENV=production node dist/api/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "generate:ppt": "ts-node src/cli/generate-powerpoint.ts",
    "generate:excel": "ts-node src/cli/generate-excel.ts",
    "generate:word": "ts-node src/cli/generate-word.ts",
    "test:orchestrator": "ts-node src/cli/test-orchestrator.ts",
    "test:advanced-ai": "ts-node src/cli/test-advanced-ai.ts",
    "test:websocket": "ts-node src/cli/test-websocket.ts",
    "validate:design": "ts-node src/cli/validate-design.ts",
    "docker:build": "docker build -t fenix-project-manager:latest .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "deploy": "bash deploy.sh",
    "deploy:windows": "powershell -ExecutionPolicy Bypass -File deploy.ps1"
  },
  "keywords": [
    "document-generation",
    "powerpoint",
    "excel",
    "word",
    "ai",
    "aws-bedrock",
    "operations"
  ],
  "author": "PHX6 Operations",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.490.0",
    "axe-core": "^4.11.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "chroma-js": "^3.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mathjs": "^15.1.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^8.1.0",
    "pptxgenjs": "^3.12.0",
    "readability-scores": "^1.0.8",
    "sentiment": "^5.0.2",
    "sharp": "^0.34.5",
    "simple-statistics": "^7.8.8",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "write-good": "^1.0.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/chroma-js": "^3.1.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/natural": "^5.1.5",
    "@types/node": "^20.10.6",
    "@types/sentiment": "^5.0.4",
    "@types/uuid": "^9.0.8",
    "@types/validator": "^13.15.10",
    "@types/write-good": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
